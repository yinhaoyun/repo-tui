Screen {
    layout: vertical;
}

HeaderBar {
    height: 1;
    background: $primary-background;
    color: $text;
    padding: 0 1;
}

#body {
    height: 1fr;
}

ProjectList {
    width: 44%;
}

Splitter {
    width: 1;
    height: 1fr;
    color: $primary-background-lighten-2;
}

Splitter:hover, Splitter.-dragging {
    color: $accent;
    background: $accent 30%;
}

DetailPane {
    width: 1fr;
    padding: 0 1;
}

#project-summary {
    height: auto;
    padding: 0 0 1 0;
    border-bottom: solid $primary-background-lighten-2;
    margin-bottom: 1;
}

FileTable {
    height: 1fr;
}

#filter-bar {
    height: 1;
    dock: bottom;
}

KeyBar {
    height: 1;
    dock: bottom;
    background: $primary-background;
    color: $text;
    padding: 0 1;
}

HelpModal {
    align: center middle;
}

#help-box {
    width: 72;
    height: auto;
    max-height: 90%;
    background: $panel;
    border: round $primary;
    padding: 1 2;
}

DiffScreen {
    align: center middle;
}

#diff-box {
    width: 90%;
    height: 90%;
    background: $panel;
    border: round $primary;
}

#diff-title {
    height: 1;
    padding: 0 1;
    background: $primary-background;
}

#diff-log {
    height: 1fr;
    padding: 0 1;
}

PromptModal {
    align: center middle;
}

#prompt-box {
    width: 60;
    height: auto;
    background: $panel;
    border: round $primary;
    padding: 1 2;
}

#prompt-label {
    height: auto;
    padding-bottom: 1;
}

ContextMenu {
    align: center middle;
}

#menu-box {
    width: 50;
    height: auto;
    max-height: 80%;
    background: $panel;
    border: round $primary;
    padding: 1 2;
}

#menu-title {
    height: auto;
    padding-bottom: 1;
}

ActionPanel {
    align: left bottom;
    background: $background 30%;
}

#action-box {
    width: auto;
    height: auto;
    max-width: 100%;
    margin: 0 1;
    background: $panel;
    border: round $warning;
    border-title-color: $warning;
    border-title-style: bold;
    padding: 0 2;
}

#action-keys {
    width: auto;
}

#action-bar {
    height: 1;
    width: 100%;
    background: $warning 40%;
    padding: 0 1;
}

BusyModal {
    align: center middle;
}

#busy-box {
    width: 80;
    max-width: 100%;
    height: auto;
    background: $panel;
    border: round $warning;
    padding: 1 2;
}

#busy-bar {
    margin-top: 1;
}

#busy-status {
    height: 1;
}

#busy-progress {
    height: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#busy-log {
    height: 8;
    margin: 1 0;
    background: $surface;
}

ConfirmModal {
    align: center middle;
}

#confirm-box {
    width: 80;
    max-width: 100%;
    height: auto;
    background: $panel;
    border: round $error;
    padding: 1 2;
}

#confirm-body {
    margin: 1 0;
}
