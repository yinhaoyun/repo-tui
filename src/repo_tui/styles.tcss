Screen {
    layout: vertical;
}

HeaderBar {
    height: 1;
    background: $primary-background;
    color: $text;
    padding: 0 1;
}

HeaderBar > Static {
    width: auto;
    height: 1;
}

HeaderBar > #hdr-status {
    width: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.hdr-link {
    text-style: underline;
}

.hdr-link:hover {
    background: $boost;
    text-style: bold underline;
}

#body {
    height: 1fr;
}

ProjectList {
    width: 44%;
}

Splitter {
    width: 3;
    height: 1fr;
    color: $primary-background-lighten-2;
}

Splitter:hover, Splitter.-dragging {
    color: $accent;
    background: $accent 30%;
}

DetailPane {
    width: 1fr;
    padding: 0 1 0 0;  /* the splitter's right column is the left gap */
}

#project-summary {
    height: auto;
    padding: 0 0 1 0;
    border-bottom: solid $primary-background-lighten-2;
    margin-bottom: 1;
}

FileTable {
    height: 1fr;
}

#filter-bar {
    height: 1;
    dock: bottom;
}

KeyBar {
    height: 2;
    dock: bottom;
    background: $primary-background;
    color: $text;
    padding: 0 1;
    /* never wrap: a wrapped focus line would push the global line out */
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

HelpModal {
    align: center middle;
}

#help-box {
    width: 90;
    max-width: 100%;
    overflow-y: auto;
    height: auto;
    max-height: 90%;
    background: $panel;
    border: round $primary;
    padding: 1 2;
}

DiffScreen {
    align: center middle;
}

#diff-box {
    width: 90%;
    height: 90%;
    background: $panel;
    border: round $primary;
}

#diff-title {
    height: 1;
    padding: 0 1;
    background: $primary-background;
}

#diff-log {
    height: 1fr;
    padding: 0 1;
}

ResultScreen {
    align: center middle;
}

#result-box {
    width: 90%;
    height: 90%;
    background: $panel;
    border: round $success;
}

#result-box.-warning {
    border: round $warning;
}

#result-box.-error {
    border: round $error;
}

#result-title {
    height: 1;
    padding: 0 1;
    background: $primary-background;
}

#result-problems {
    height: auto;
    max-height: 12;
    margin: 1 1 0 1;
    padding: 0 1;
    border: round $error;
    border-title-color: $error;
}

#result-box.-warning #result-problems {
    border: round $warning;
}

#result-updates {
    height: auto;
    padding: 1 1 0 1;
}

#result-log {
    height: 1fr;
    padding: 0 1;
}

PromptModal {
    align: center middle;
}

#prompt-box {
    width: 60;
    height: auto;
    background: $panel;
    border: round $primary;
    padding: 1 2;
}

#prompt-label {
    height: auto;
    padding-bottom: 1;
}

ContextMenu {
    align: center middle;
}

#menu-box {
    width: 50;
    height: auto;
    max-height: 80%;
    background: $panel;
    border: round $primary;
    padding: 1 2;
}

#menu-title {
    height: auto;
    padding-bottom: 1;
}

PickerModal {
    align: center middle;
}

#picker-box {
    width: 70;
    max-width: 100%;
    height: auto;
    max-height: 90%;
    background: $panel;
    border: round $primary;
    padding: 1 2;
}

#picker-title {
    height: auto;
    padding-bottom: 1;
}

#picker-list {
    height: auto;
    max-height: 16;
}

#confirm-body {
    max-height: 30;
    overflow-y: auto;
}

#menu-keys, #prompt-keys, #picker-keys {
    height: auto;
    padding-top: 1;
}

ActionPanel {
    align: left bottom;
    background: $background 30%;
}

#action-box {
    width: auto;
    height: auto;
    max-width: 100%;
    margin: 0 1;
    background: $panel;
    border: round $warning;
    border-title-color: $warning;
    border-title-style: bold;
    padding: 0 2;
}

#action-keys {
    width: auto;
}

#action-bar {
    height: 1;
    width: 100%;
    background: $warning 40%;
    padding: 0 1;
}

BusyModal {
    align: center middle;
}

#busy-box {
    width: 80;
    max-width: 100%;
    height: auto;
    background: $panel;
    border: round $warning;
    padding: 1 2;
}

#busy-bar {
    margin-top: 1;
}

#busy-status {
    height: 1;
}

#busy-progress {
    height: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#busy-log {
    height: 8;
    margin: 1 0;
    background: $surface;
}

ConfirmModal {
    align: center middle;
}

#confirm-box {
    width: 80;
    max-width: 100%;
    height: auto;
    background: $panel;
    border: round $error;
    padding: 1 2;
}

#confirm-body {
    margin: 1 0;
}

SettingsScreen {
    align: center middle;
}

#settings-box {
    width: 76;
    max-width: 100%;
    height: auto;
    background: $panel;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
}

#settings-tabs {
    height: 1;
    margin: 1 0;
}

.settings-tab {
    width: auto;
    margin-right: 1;
    color: $text-muted;
}

.settings-tab:hover {
    background: $boost;
}

.settings-tab.-active {
    background: $accent;
    color: $text;
    text-style: bold;
}

#settings-rows {
    height: auto;
    min-height: 5;
    border-top: solid $accent 50%;
    padding-top: 1;
}

.setting-row {
    height: 1;
}

.setting-row:hover {
    background: $boost;
}

.setting-row.-selected {
    background: $accent 20%;
}

#settings-help {
    height: auto;
    min-height: 2;
    margin-top: 1;
    padding: 1 1 0 1;
    border-top: solid $accent 50%;
    color: $text-muted;
}

#settings-status {
    height: auto;
    padding: 0 1;
}

#settings-keys {
    height: 1;
    margin-top: 1;
    padding: 0 1;
}

SyncReportScreen, ChangedScreen, LogScreen {
    align: center middle;
}

#report-box, #changed-box, #log-box {
    width: 90%;
    height: 90%;
    background: $panel;
    border: round $accent;
}

#report-title, #changed-title, #log-title {
    height: 1;
    padding: 0 1;
    background: $primary-background;
}

#report-summary, #log-summary {
    height: auto;
    padding: 1 1 0 1;
}

#report-body, #log-body {
    height: 1fr;
    margin-top: 1;
}

#report-list {
    width: 40%;
    height: 1fr;
}

#report-detail {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

#log-list {
    width: 55%;
    height: 1fr;
}

#log-detail {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

#log-filter {
    margin: 1 1 0 1;
}

#report-keys, #changed-keys, #log-keys {
    height: 1;
    padding: 0 1;
}

#report-empty {
    padding: 1;
}

#changed-table {
    height: 1fr;
}
